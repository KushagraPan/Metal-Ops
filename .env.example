# Copy to .env and fill in locally. Never commit .env.

# Backend
# Defaults to sqlite:///./data/metalops.db when unset.
DATABASE_URL=
STORAGE_DIR=
OWNER_EMAIL=
# Plain password (minimum 10 characters) used on first bootstrap only.
# Note: Changing OWNER_PASSWORD after the first start does not change the stored hash.
OWNER_PASSWORD=
# Or provide a pre-computed scrypt/pbkdf2 hash:
OWNER_PASSWORD_HASH=

# Telemetry
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Alerting
ALERT_WEBHOOK_URL=

# Frontend (read at build time by Vite)
VITE_API_BASE_URL=
