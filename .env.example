# Copy to .env and fill in locally. Never commit .env.

# Application Environment (development | production)
ENV=

# Database Configuration
# In Docker Compose, defaults to:
# postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# For local dev without Docker, defaults to sqlite:///./data/metalops.db when unset.
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Storage Directory for uploaded PDF lab reports
# In Docker Compose, defaults to /app/storage (mounted to named volume metalops_uploads).
# For local dev without Docker, defaults to data/storage.
STORAGE_DIR=

# Demo Owner Credentials & Seeding
# Initial owner account bootstrap.
# Plain password MUST be at least 10 characters long (demo only).
# Note: Changing OWNER_PASSWORD after the first startup does not change the stored hash.
# e.g. OWNER_EMAIL=owner@workshop.local
OWNER_EMAIL=
# e.g. OWNER_PASSWORD=change_this_demo_password_10chars
OWNER_PASSWORD=
# Or provide a pre-computed scrypt/pbkdf2 hash:
OWNER_PASSWORD_HASH=

# Set to 1 to seed demo lots, heats, sales, fixed expenses, and sample reports on startup:
SEED_DEMO=

# Frontend Port (defaults to 3000, bound to 127.0.0.1)
FRONTEND_PORT=

# Timezone (defaults to Asia/Kolkata for dashboard monthly metrics)
TZ=

# Allowed CORS / CSRF Origins (optional comma-separated origins)
ALLOWED_ORIGINS=

# Telemetry (Issue #16)
# Leave the endpoint empty to keep telemetry off. Compose sets it only when the
# observability profile is enabled.
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Observability stack (Issue #16 Part 2)
# Required by compose.observability.yaml. Use a unique local password; never commit it.
GRAFANA_ADMIN_PASSWORD=
# Grafana is published on loopback only.
GRAFANA_PORT=

# Alerting (Issue #17)
ALERT_WEBHOOK_URL=

# Frontend (read at build time by Vite, empty when served behind Nginx reverse proxy)
VITE_API_BASE_URL=
