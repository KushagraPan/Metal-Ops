# Copy to .env and fill in locally. Never commit .env.

# Application Environment (development | production)
ENV=production

# Database Configuration
# In Docker Compose, DATABASE_URL is constructed automatically from postgres credentials:
# postgresql+psycopg://metalops:metalops_password@postgres:5432/metalops
# For local dev without Docker, defaults to sqlite:///./data/metalops.db when unset.
DATABASE_URL=
POSTGRES_USER=metalops
POSTGRES_PASSWORD=metalops_demo_password
POSTGRES_DB=metalops

# Storage Directory for uploaded PDF lab reports
# In Docker Compose, defaults to /app/storage (mounted to named volume metalops_uploads).
# For local dev without Docker, defaults to data/storage.
STORAGE_DIR=/app/storage

# Demo Owner Credentials & Seeding
# Initial owner account bootstrap.
# Plain password MUST be at least 10 characters long (demo only).
# Note: Changing OWNER_PASSWORD after the first startup does not change the stored hash.
OWNER_EMAIL=owner@workshop.local
OWNER_PASSWORD=change_this_demo_password_10chars
# Or provide a pre-computed scrypt/pbkdf2 hash:
OWNER_PASSWORD_HASH=

# Set to 1 to seed demo lots, heats, sales, fixed expenses, and sample reports on startup:
SEED_DEMO=1

# Frontend Port (defaults to 3000, bound to 127.0.0.1)
FRONTEND_PORT=3000

# Timezone (defaults to Asia/Kolkata for dashboard monthly metrics)
TZ=Asia/Kolkata

# Telemetry (Issue #16)
OTEL_SERVICE_NAME=metalops
OTEL_EXPORTER_OTLP_ENDPOINT=

# Alerting (Issue #17)
ALERT_WEBHOOK_URL=

# Frontend (read at build time by Vite, empty when served behind Nginx reverse proxy)
VITE_API_BASE_URL=
